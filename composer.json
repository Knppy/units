{
    "name": "knppy/units",
    "description": "PHP library to make working with units safer, easier, and fun!",
    "keywords": [
        "Knppy",
        "units"
    ],
    "homepage": "https://github.com/knppy/units",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Beers",
            "email": "michael@michaelbeers.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "pestphp/pest": "^5.3",
        "laravel/pint": "^1.19",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Knppy\\Units\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Knppy\\Units\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --no-coverage",
        "test:unit": "vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
