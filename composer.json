{
    "name": "knppy/units",
    "description": "PHP library to make working with units safer, easier, and fun!",
    "keywords": [
        "Knppy",
        "units"
    ],
    "homepage": "https://github.com/knppy/units",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Beers",
            "email": "michael@michaelbeers.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.0",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Knppy\\Units\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Knppy\\Units\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
            "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
